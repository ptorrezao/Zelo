<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <!-- Para IEndpointFilter/RouteGroupBuilder (RequireFeatureFlag,
         RequireHouseholdMembership), sem ser um projeto Sdk.Web inteiro. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <!-- IHouseholdMembershipChecker (RequireHouseholdMembership) - sem
         risco de ciclo, Zelo.SharedKernel nao depende de nada. -->
    <ProjectReference Include="..\Zelo.SharedKernel\Zelo.SharedKernel.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Microsoft.Extensions.Configuration.Abstractions / .Diagnostics.HealthChecks
         / .Options.ConfigurationExtensions / .Http ja vem com o FrameworkReference
         acima - referencia-los outra vez da erro de "package pruning". -->
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" />
  </ItemGroup>
</Project>
