# Copia para .env (nao commitado - ver .gitignore) e preenche os valores
# reais. docker compose le infra/compose/.env automaticamente.

# Chave da OpenAI, usada so pelo worker para gerar a foto dos veiculos
# (ver VehiclePhotoHandler). Sem isto a geracao falha (401) e fica so a
# logar um warning - nunca bloqueia a criacao do veiculo.
OPENAI_API_KEY=
