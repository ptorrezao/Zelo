# Encaminhamento dos microfrontends e da API.
# Deploys independentes por app; o gateway e o unico ponto de entrada.

localhost {
	handle /api/* {
		reverse_proxy api:8080
	}

	handle /auto/* {
		reverse_proxy frontend-auto:3000
	}

	handle /inventario/* {
		reverse_proxy frontend-inventory:3000
	}

	handle {
		reverse_proxy frontend-shell:3000
	}
}
